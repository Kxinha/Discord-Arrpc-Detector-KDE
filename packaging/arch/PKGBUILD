# Maintainer: kxinha <gabriel17166@gmail.com>
pkgname=discord-game-presence
pkgver=1.0.0
pkgrel=1
pkgdesc="Rich Presence for games and apps Discord ignores on Linux"
arch=('any')
url="https://github.com/gabrielmf1998/Discord-Arrpc-Detector-KDE"
license=('MIT')
depends=('python' 'python-gobject' 'gtk3' 'iproute2')
optdepends=('libayatana-appindicator: tray icon'
            'librsvg: tray icon rendering'
            'vesktop: Discord client that exposes the IPC socket')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/Discord-Arrpc-Detector-KDE-$pkgver"
    install -Dm755 discord-game-presence.py "$pkgdir/usr/bin/$pkgname"
    install -Dm755 discord-presence-tray.py "$pkgdir/usr/bin/discord-presence-tray"
    install -Dm644 packaging/files/$pkgname.service \
        "$pkgdir/usr/lib/systemd/user/$pkgname.service"
    install -Dm644 packaging/files/$pkgname-tray.service \
        "$pkgdir/usr/lib/systemd/user/$pkgname-tray.service"
    install -Dm644 packaging/files/discord-presence-tray.desktop \
        "$pkgdir/usr/share/applications/discord-presence-tray.desktop"
    install -Dm644 packaging/files/$pkgname.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 INSTALAR.txt "$pkgdir/usr/share/doc/$pkgname/INSTALAR.txt"
}
